{
  "name": "swft-git-push",
  "displayName": "swft.push",
 "description": "A VS Code extension to push code to GitHub directly from VS Code using a CLI button",
  "icon": "images/logo.png",
  "publisher": "swft-xt",
  "version": "0.0.8",
  "keywords": [
    "swft",
    "git",
    "push",
    "cli",
    "vscode"
  ],
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitpush.cli",
        "title": "🚀 Push with CLI"
      }
    ]
  }
}
